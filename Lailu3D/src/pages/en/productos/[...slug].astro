---
/**
 * Envoltorio de ruta. El cuerpo vive en `components/paginas/` y lo comparten
 * el espanol (raiz) y el ingles (/en): una correccion se hace una sola vez.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import PaginaProducto from '../../../components/paginas/PaginaProducto.astro';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((producto) => ({
    params: { slug: producto.id },
    props: { producto },
  }));
}

interface Props {
  producto: CollectionEntry<'productos'>;
}

const { producto } = Astro.props;
---

<PaginaProducto producto={producto} idioma="en" />
