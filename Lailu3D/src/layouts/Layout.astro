---
import '../styles/global.css';
import { site, idiomaPorDefecto, type Idioma } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsAppFlotante from '../components/BotonWhatsAppFlotante.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta bajo /public de la imagen social. Se genera en la fase 6. */
  imagenOg?: string;
  /** Rutas de trabajo (kit de componentes) que no deben indexarse. */
  noindex?: boolean;
}

const { titulo, descripcion, imagenOg, noindex = false } = Astro.props;

const idioma = (Astro.currentLocale ?? idiomaPorDefecto) as Idioma;
const canonica = new URL(Astro.url.pathname, site.url).href;
const tituloCompleto = `${titulo} | ${site.nombre}`;
const urlOg = imagenOg ? new URL(imagenOg, site.url).href : undefined;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={idioma === 'en' ? 'en_US' : 'es_EC'} />
    {urlOg && <meta property="og:image" content={urlOg} />}
    <meta
      name="twitter:card"
      content={urlOg ? 'summary_large_image' : 'summary'}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600&display=swap"
    />
  </head>
  <body class="bg-background text-on-background font-body antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[4px] focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <BotonWhatsAppFlotante />
  </body>
</html>
