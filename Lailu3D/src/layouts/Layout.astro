---
import '../styles/global.css';
import { site, idiomas, idiomaPorDefecto, type Idioma } from '../config/site';
import { t, rutaLocalizada } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsAppFlotante from '../components/BotonWhatsAppFlotante.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta bajo /public de la imagen social. Por defecto, la de la marca. */
  imagenOg?: string;
  /** Rutas de trabajo (kit de componentes) que no deben indexarse. */
  noindex?: boolean;
}

const {
  titulo,
  descripcion,
  imagenOg = '/og.png',
  noindex = false,
} = Astro.props;

const idioma = (Astro.currentLocale ?? idiomaPorDefecto) as Idioma;
const txt = t(idioma);
const canonica = new URL(Astro.url.pathname, site.url).href;
const tituloCompleto = `${titulo} | ${site.nombre}`;
const urlOg = new URL(imagenOg, site.url).href;

const etiquetaOg: Record<Idioma, string> = { es: 'es_EC', en: 'en_US' };

/**
 * Alternativas de idioma de ESTA misma pagina. `x-default` apunta al espanol,
 * que es el idioma de la raiz. Las rutas noindex (el kit) no las declaran: no
 * tienen gemela ni deben aparecer en un buscador.
 */
const alternativas = noindex
  ? []
  : idiomas.map((codigo) => ({
      codigo,
      url: new URL(rutaLocalizada(Astro.url.pathname, codigo), site.url).href,
    }));
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      alternativas.map((alt) => (
        <link rel="alternate" hreflang={alt.codigo} href={alt.url} />
      ))
    }
    {
      alternativas.length > 0 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={
            alternativas.find((alt) => alt.codigo === idiomaPorDefecto)!.url
          }
        />
      )
    }

    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={etiquetaOg[idioma]} />
    {
      alternativas
        .filter((alt) => alt.codigo !== idioma)
        .map((alt) => (
          <meta property="og:locale:alternate" content={etiquetaOg[alt.codigo]} />
        ))
    }
    <meta property="og:image" content={urlOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.nombre} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Fuentes propias (ver `styles/global.css`). Se precargan las dos del
      subconjunto latino porque las usa cualquier pagina: sin esto el navegador
      no las descubre hasta terminar de leer el CSS.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/space-grotesk-latin-wght-normal.woff2"
      crossorigin
    />
  </head>
  <body class="bg-background text-on-background font-body antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[4px] focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      {txt.html.saltar}
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <BotonWhatsAppFlotante />
  </body>
</html>
