---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logoMark from '../../assets/brand/logo-mark.svg';
import litofaniaEncendida from '../../assets/trabajos/litofania-encendida.jpg';
import litofaniaApagada from '../../assets/trabajos/litofania-apagada.jpg';
import bateria from '../../assets/trabajos/llavero-bateria.jpg';
import cubo from '../../assets/trabajos/cubo-infinito.jpg';
import guante from '../../assets/trabajos/llavero-guante.jpg';
import mancuerna from '../../assets/trabajos/llavero-mancuerna.jpg';
import shaker from '../../assets/trabajos/llavero-shaker.jpg';
import disco from '../../assets/trabajos/llavero-disco-gimnasio.jpg';
import pesaRusa from '../../assets/trabajos/llavero-pesa-rusa.jpg';
import Layout from '../../layouts/Layout.astro';
import Seccion from '../ui/Seccion.astro';
import Tarjeta from '../ui/Tarjeta.astro';
import Boton from '../ui/Boton.astro';
import Chip from '../ui/Chip.astro';
import TarjetaProducto from '../TarjetaProducto.astro';
import IconoWhatsApp from '../ui/IconoWhatsApp.astro';
import JsonLd from '../JsonLd.astro';
import { site, type Idioma } from '../../config/site';
import { slugsServicio } from '../../lib/servicios';
import { waGeneral } from '../../lib/whatsapp';
import { t, rutaLocalizada } from '../../i18n';
import { negocio } from '../../lib/jsonld';

/**
 * Cuerpo de la landing, compartido por `/` y `/en`. Las paginas de `src/pages`
 * son envoltorios de tres lineas: asi una correccion se hace una sola vez y no
 * se olvida en un idioma.
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const txt = t(idioma);
const ruta = (destino: string) => rutaLocalizada(destino, idioma);

/**
 * Destacados del catalogo. Se marcan con `destacado: true` en el frontmatter
 * del producto: la landing no mantiene su propia lista.
 */
const destacados = (await getCollection('productos'))
  .filter((p) => p.data.destacado)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);

const pasos = [
  { numero: '01', ...txt.inicio.pasos.idea },
  { numero: '02', ...txt.inicio.pasos.cotizamos },
  { numero: '03', ...txt.inicio.pasos.producimos },
];

/**
 * Galeria de trabajos entregados. La foto vive aqui porque i18n solo guarda
 * texto; el titulo, la categoria y el alt salen del diccionario.
 */
const trabajos = [
  { imagen: litofaniaEncendida, ...txt.inicio.trabajos.litofaniaEncendida },
  { imagen: litofaniaApagada, ...txt.inicio.trabajos.litofaniaApagada },
  { imagen: bateria, ...txt.inicio.trabajos.bateria },
  { imagen: cubo, ...txt.inicio.trabajos.cubo },
  { imagen: guante, ...txt.inicio.trabajos.guante },
  { imagen: mancuerna, ...txt.inicio.trabajos.mancuerna },
  { imagen: shaker, ...txt.inicio.trabajos.shaker },
  { imagen: disco, ...txt.inicio.trabajos.disco },
  { imagen: pesaRusa, ...txt.inicio.trabajos.pesaRusa },
];

const waIdea = waGeneral(idioma, ruta('/'));
---

<Layout
  titulo={txt.inicio.meta.titulo}
  descripcion={txt.inicio.meta.descripcion}
>
  <JsonLd datos={negocio(idioma)} />

  {/* --- Hero --- */}
  <section class="px-margin-mobile py-16 md:px-margin md:py-24">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[1.1fr_0.9fr]"
    >
      <div>
        <p class="font-display text-label-md uppercase text-primary">
          {site.sucursales.join(' · ')} — {txt.inicio.hero.region}
        </p>

        <h1
          class="mt-4 text-display-lg-mobile md:text-display-lg text-on-surface"
        >
          {txt.inicio.hero.titulo}
        </h1>

        <p class="mt-6 max-w-xl text-body-lg text-on-surface-variant">
          {txt.inicio.hero.texto}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Boton href={ruta('/cotizar')} tamano="lg">
            {txt.inicio.hero.ctaPrimario}
          </Boton>
          <Boton href={ruta('/productos')} variante="secondary" tamano="lg">
            {txt.inicio.hero.ctaSecundario}
          </Boton>
        </div>

        <p class="mt-6 text-body-sm text-on-surface-variant">
          {txt.inicio.hero.nota}
        </p>
      </div>

      {/* Panel técnico: sustituye a la foto de portada hasta tener material real. */}
      <div class="elev-2 rounded-xl p-6 md:p-8">
        <div class="flex items-center justify-between gap-4">
          <p class="font-display text-label-md uppercase text-on-surface-variant">
            {txt.inicio.panel.etiqueta}
          </p>
          <span
            class="inline-flex items-center gap-1.5 font-display text-label-sm uppercase text-on-surface-variant"
          >
            <span class="size-1.5 rounded-full bg-primary" aria-hidden="true"
            ></span>
            {txt.inicio.panel.estado}
          </span>
        </div>

        <div
          class="mt-6 flex items-center justify-center rounded-lg bg-surface-container py-10"
        >
          <img
            src={logoMark.src}
            width={logoMark.width}
            height={logoMark.height}
            alt="Lailu3D"
            class="h-32 w-auto md:h-40"
          />
        </div>

        <dl
          class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-outline-variant pt-6"
        >
          <div>
            <dt
              class="font-display text-label-sm uppercase text-on-surface-variant"
            >
              {txt.inicio.panel.tecnologia}
            </dt>
            <dd class="mt-1 text-body-md text-on-surface">
              {txt.inicio.panel.tecnologiaValor}
            </dd>
          </div>
          <div>
            <dt
              class="font-display text-label-sm uppercase text-on-surface-variant"
            >
              {txt.inicio.panel.material}
            </dt>
            <dd class="mt-1 text-body-md text-on-surface">
              {txt.inicio.panel.materialValor}
            </dd>
          </div>
          <div>
            <dt
              class="font-display text-label-sm uppercase text-on-surface-variant"
            >
              {txt.inicio.panel.cantidad}
            </dt>
            <dd class="mt-1 text-body-md text-on-surface tabular">
              {txt.inicio.panel.cantidadValor}
            </dd>
          </div>
          <div>
            <dt
              class="font-display text-label-sm uppercase text-on-surface-variant"
            >
              {txt.inicio.panel.entrega}
            </dt>
            <dd class="mt-1 text-body-md text-on-surface">
              {txt.inicio.panel.entregaValor}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* --- Servicios --- */}
  <Seccion
    id="servicios"
    etiqueta={txt.inicio.servicios.etiqueta}
    titulo={txt.inicio.servicios.titulo}
    descripcion={txt.inicio.servicios.descripcion}
    fondo="alterno"
  >
    <div class="grid gap-6 md:grid-cols-2">
      {
        slugsServicio.map((slug) => {
          const servicio = txt.servicios[slug];
          return (
            <Tarjeta class="flex flex-col">
              <h3 class="text-headline-sm text-on-surface">{servicio.titulo}</h3>
              <p class="mt-3 flex-1 text-body-md text-on-surface-variant">
                {servicio.texto}
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                {servicio.chips.map((chip) => (
                  <Chip>{chip}</Chip>
                ))}
              </div>

              <div class="mt-6">
                {/* El cotizador llega con el servicio ya elegido. */}
                <Boton
                  href={`${ruta('/cotizar')}?servicio=${slug}`}
                  variante="secondary"
                >
                  {txt.inicio.servicios.cta}
                </Boton>
              </div>
            </Tarjeta>
          );
        })
      }
    </div>
  </Seccion>

  {/* --- Cómo funciona --- */}
  <Seccion
    id="como-funciona"
    etiqueta={txt.inicio.pasos.etiqueta}
    titulo={txt.inicio.pasos.titulo}
    descripcion={txt.inicio.pasos.descripcion}
  >
    <ol class="grid gap-6 md:grid-cols-3">
      {
        pasos.map((paso) => (
          <li>
            <Tarjeta elevacion={1} class="h-full">
              <p class="font-display text-headline-md text-primary tabular">
                {paso.numero}
              </p>
              <h3 class="mt-3 text-headline-sm text-on-surface">
                {paso.titulo}
              </h3>
              <p class="mt-2 text-body-md text-on-surface-variant">
                {paso.texto}
              </p>
            </Tarjeta>
          </li>
        ))
      }
    </ol>
  </Seccion>

  {/* --- Destacados del catálogo --- */}
  {
    destacados.length > 0 && (
      <Seccion
        id="catalogo"
        etiqueta={txt.inicio.destacados.etiqueta}
        titulo={txt.inicio.destacados.titulo}
        descripcion={txt.inicio.destacados.descripcion}
        fondo="alterno"
      >
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {destacados.map((producto) => (
            <TarjetaProducto producto={producto} idioma={idioma} />
          ))}
        </div>

        <div class="mt-10">
          <Boton href={ruta('/productos')} variante="secondary">
            {txt.inicio.destacados.cta}
          </Boton>
        </div>
      </Seccion>
    )
  }

  {/* --- Trabajos previos --- */}
  <Seccion
    id="trabajos"
    etiqueta={txt.inicio.trabajos.etiqueta}
    titulo={txt.inicio.trabajos.titulo}
    descripcion={txt.inicio.trabajos.descripcion}
  >
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        trabajos.map((trabajo) => (
          <li class="elev-1 flex flex-col overflow-hidden rounded-lg">
            <div class="aspect-square bg-surface-container">
              <Image
                src={trabajo.imagen}
                alt={trabajo.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw"
                loading="lazy"
                decoding="async"
                class="size-full object-cover"
              />
            </div>
            <div class="border-t border-outline-variant p-5">
              <p class="font-display text-label-sm uppercase text-on-surface-variant">
                {trabajo.categoria}
              </p>
              <p class="mt-1 text-body-md text-on-surface">{trabajo.titulo}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Seccion>

  {/* --- CTA final --- */}
  <section class="px-margin-mobile pb-20 md:px-margin">
    <div
      class="mx-auto max-w-6xl rounded-xl bg-primary px-6 py-12 text-center md:px-16 md:py-16"
    >
      <h2 class="text-headline-lg-mobile md:text-headline-lg text-on-primary">
        {txt.inicio.cta.titulo}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-body-lg text-primary-fixed">
        {txt.inicio.cta.texto}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Boton href={ruta('/cotizar')} variante="inverso" tamano="lg">
          {txt.inicio.cta.primario}
        </Boton>
        {/* Salida directa para quien solo quiere preguntar algo suelto. */}
        <Boton href={waIdea} externo variante="inverso-outline" tamano="lg">
          <IconoWhatsApp class="size-5" />
          {txt.inicio.cta.secundario}
        </Boton>
      </div>

      <p class="mt-6 text-body-sm text-primary-fixed">
        {site.whatsapp.display} · {txt.inicio.cta.cobertura}
      </p>
    </div>
  </section>
</Layout>
