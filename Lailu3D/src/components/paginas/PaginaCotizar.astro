---
import Layout from '../../layouts/Layout.astro';
import Tarjeta from '../ui/Tarjeta.astro';
import FormularioCotizacion from '../FormularioCotizacion.astro';
import IconoWhatsApp from '../ui/IconoWhatsApp.astro';
import { site, type Idioma } from '../../config/site';
import { waGeneral } from '../../lib/whatsapp';
import { t, rutaLocalizada } from '../../i18n';

/** Cuerpo del cotizador, compartido por `/cotizar` y `/en/cotizar`. */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const txt = t(idioma);
const wa = waGeneral(idioma, Astro.url.pathname);

/** Lo que el encargado necesita saber para poder poner un precio. */
const necesitamos = [
  txt.cotizar.necesitamos.pieza,
  txt.cotizar.necesitamos.tamano,
  txt.cotizar.necesitamos.fecha,
];
---

<Layout titulo={txt.cotizar.meta.titulo} descripcion={txt.cotizar.meta.descripcion}>
  <div class="px-margin-mobile py-12 md:px-margin md:py-20">
    <div class="mx-auto max-w-6xl">
      <nav aria-label={txt.nav.migas} class="mb-8">
        <ol
          class="flex flex-wrap items-center gap-2 text-body-sm text-on-surface-variant"
        >
          <li>
            <a href={rutaLocalizada('/', idioma)} class="hover:text-on-surface">
              {txt.nav.inicio}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-on-surface">{txt.cotizar.miga}</li>
        </ol>
      </nav>

      <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <p class="font-display text-label-md uppercase text-primary">
            {txt.cotizar.etiqueta}
          </p>
          <h1
            class="mt-3 text-headline-lg-mobile md:text-headline-lg text-on-surface"
          >
            {txt.cotizar.titulo}
          </h1>
          <p class="mt-5 max-w-xl text-body-lg text-on-surface-variant">
            {txt.cotizar.texto}
          </p>

          <div class="mt-10">
            <FormularioCotizacion idioma={idioma} />
          </div>
        </div>

        <aside class="flex flex-col gap-6">
          <Tarjeta etiqueta={txt.cotizar.necesitamos.titulo}>
            <ul class="flex flex-col gap-5">
              {
                necesitamos.map((punto) => (
                  <li>
                    <p class="text-body-lg text-on-surface">{punto.titulo}</p>
                    <p class="mt-1 text-body-md text-on-surface-variant">
                      {punto.texto}
                    </p>
                  </li>
                ))
              }
            </ul>
          </Tarjeta>

          <Tarjeta elevacion={1} etiqueta={txt.cotizar.directo.titulo}>
            <p class="text-body-md text-on-surface-variant">
              {txt.cotizar.directo.texto}
            </p>
            <a
              href={wa}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 text-body-lg text-on-surface hover:text-primary"
            >
              <IconoWhatsApp class="size-5" />
              <span class="tabular">{site.whatsapp.display}</span>
            </a>
            <p class="mt-4 text-body-sm text-on-surface-variant">
              {site.sucursales.join(' · ')} — {txt.cotizar.directo.aviso}
            </p>
          </Tarjeta>
        </aside>
      </div>
    </div>
  </div>
</Layout>
