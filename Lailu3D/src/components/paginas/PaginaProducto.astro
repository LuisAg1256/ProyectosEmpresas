---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Boton from '../ui/Boton.astro';
import Badge from '../ui/Badge.astro';
import Chip from '../ui/Chip.astro';
import TarjetaProducto from '../TarjetaProducto.astro';
import IconoWhatsApp from '../ui/IconoWhatsApp.astro';
import JsonLd from '../JsonLd.astro';
import type { Idioma } from '../../config/site';
import { formatearPrecio, categorias } from '../../lib/formato';
import { waProducto } from '../../lib/whatsapp';
import { t, rutaLocalizada } from '../../i18n';
import { producto as productoJsonLd, migas } from '../../lib/jsonld';

/** Ficha de producto, compartida por `/productos/<slug>` y su gemela en `/en`. */
interface Props {
  producto: CollectionEntry<'productos'>;
  idioma: Idioma;
}

const { producto, idioma } = Astro.props;
const { data } = producto;
const { Content } = await render(producto);

const txt = t(idioma);
const ruta = Astro.url.pathname;

/** El mensaje sale con nombre, codigo y URL absoluta de esta misma ficha. */
const wa = waProducto(data, ruta, idioma);
const alt = data.imagenAlt?.[idioma] ?? data.nombre[idioma];

/** Ficha tecnica: solo se listan los campos que el producto realmente declara. */
const especificaciones = [
  { etiqueta: txt.producto.especificaciones.codigo, valor: data.sku },
  { etiqueta: txt.producto.especificaciones.marca, valor: data.marca },
  { etiqueta: txt.producto.especificaciones.material, valor: data.material },
  {
    etiqueta: txt.producto.especificaciones.color,
    valor: data.color?.nombre[idioma],
  },
  {
    etiqueta: txt.producto.especificaciones.peso,
    valor: data.pesoGramos ? `${data.pesoGramos} g` : undefined,
  },
  {
    etiqueta: txt.producto.especificaciones.diametro,
    valor: data.diametroMm ? `${data.diametroMm} mm` : undefined,
  },
].filter((fila): fila is { etiqueta: string; valor: string } =>
  Boolean(fila.valor),
);

/**
 * El YAML plegado (`>-`) deja los saltos de parrafo como `\n`. Sin esto, la
 * descripcion larga se renderiza como un unico bloque de texto.
 */
const parrafos = data.descripcion[idioma]
  .split(/\n+/)
  .map((p) => p.trim())
  .filter(Boolean);

/** Las mismas migas que se ven en pantalla, para el buscador. */
const migasJsonLd = migas([
  { nombre: txt.nav.inicio, ruta: rutaLocalizada('/', idioma) },
  { nombre: txt.nav.catalogo, ruta: rutaLocalizada('/productos', idioma) },
  { nombre: data.nombre[idioma], ruta },
]);

const relacionados = (await getCollection('productos'))
  .filter((p) => p.id !== producto.id && p.data.categoria === data.categoria)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);
---

<Layout titulo={data.nombre[idioma]} descripcion={data.resumen[idioma]}>
  <JsonLd datos={productoJsonLd(producto, idioma, ruta)} />
  <JsonLd datos={migasJsonLd} />

  <div class="px-margin-mobile py-10 md:px-margin md:py-16">
    <div class="mx-auto max-w-6xl">
      <nav aria-label={txt.nav.migas} class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-body-sm text-on-surface-variant">
          <li>
            <a href={rutaLocalizada('/', idioma)} class="hover:text-on-surface">
              {txt.nav.inicio}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              href={rutaLocalizada('/productos', idioma)}
              class="hover:text-on-surface"
            >
              {txt.nav.catalogo}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-on-surface">{data.nombre[idioma]}</li>
        </ol>
      </nav>

      <div class="grid gap-10 md:grid-cols-2 md:gap-12">
        <div class="elev-2 overflow-hidden rounded-lg bg-surface-container">
          {/*
            Es el elemento LCP de la ficha. `<Image>` marca lazy por defecto,
            con lo que el navegador no la pide hasta hacer el layout: aqui va
            explicitamente `eager` y con prioridad alta.
          */}
          <Image
            src={data.imagen}
            alt={alt}
            width={800}
            height={800}
            loading="eager"
            fetchpriority="high"
            class="aspect-square size-full object-contain p-8"
          />
        </div>

        <div>
          <p class="font-display text-label-md uppercase text-primary">
            {categorias[data.categoria][idioma]}
          </p>

          <h1 class="mt-3 text-headline-lg-mobile md:text-headline-lg text-on-surface">
            {data.nombre[idioma]}
          </h1>

          <div class="mt-4 flex flex-wrap items-center gap-4">
            <p class="font-display text-headline-md text-primary tabular">
              {formatearPrecio(data.precio, idioma)}
            </p>
            <Badge estado={data.disponibilidad} idioma={idioma} />
          </div>

          <p class="mt-5 text-body-lg text-on-surface-variant">
            {data.resumen[idioma]}
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {data.material && <Chip>{data.material}</Chip>}
            {
              data.color && (
                <Chip hex={data.color.hex}>{data.color.nombre[idioma]}</Chip>
              )
            }
            {data.diametroMm && <Chip>{data.diametroMm} mm</Chip>}
          </div>

          <div class="mt-8">
            <Boton href={wa} externo tamano="lg" class="w-full sm:w-auto">
              <IconoWhatsApp class="size-5" />
              {txt.producto.pedir}
            </Boton>
            <p class="mt-3 text-body-sm text-on-surface-variant">
              {txt.producto.notaPedir}
            </p>
          </div>

          {
            especificaciones.length > 0 && (
              <dl class="mt-8 divide-y divide-outline-variant border-t border-outline-variant">
                {especificaciones.map((fila) => (
                  <div class="flex items-center justify-between gap-6 py-3">
                    <dt class="font-display text-label-md uppercase text-on-surface-variant">
                      {fila.etiqueta}
                    </dt>
                    <dd class="text-body-md text-on-surface tabular">
                      {fila.valor}
                    </dd>
                  </div>
                ))}
              </dl>
            )
          }
        </div>
      </div>

      <div class="mt-14 max-w-3xl">
        <h2 class="text-headline-md text-on-surface">
          {txt.producto.descripcion}
        </h2>
        <div
          class="mt-4 flex flex-col gap-4 text-body-lg text-on-surface-variant"
        >
          {parrafos.map((parrafo) => <p>{parrafo}</p>)}
          {/* Cuerpo markdown del .md, para fichas que necesiten mas detalle. */}
          <Content />
        </div>
      </div>

      {
        relacionados.length > 0 && (
          <div class="mt-16 border-t border-outline-variant pt-12">
            <h2 class="text-headline-md text-on-surface">
              {txt.producto.relacionados}
            </h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {relacionados.map((otro) => (
                <TarjetaProducto producto={otro} idioma={idioma} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</Layout>
