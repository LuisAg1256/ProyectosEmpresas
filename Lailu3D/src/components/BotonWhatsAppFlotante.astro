---
import { idiomaPorDefecto, type Idioma } from '../config/site';
import { waGeneral } from '../lib/whatsapp';
import IconoWhatsApp from './ui/IconoWhatsApp.astro';

/**
 * Acceso permanente al canal de venta. Lleva la URL de la pagina actual dentro
 * del mensaje, asi el encargado sabe desde donde escribio el cliente.
 */
const idioma = (Astro.currentLocale ?? idiomaPorDefecto) as Idioma;
const wa = waGeneral(idioma, Astro.url.pathname);
---

<a
  href={wa}
  target="_blank"
  rel="noopener noreferrer"
  class="elev-3 fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-[4px] bg-primary px-4 py-3 font-display text-[15px] font-medium leading-none text-on-primary transition-colors hover:bg-primary-container focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background md:bottom-6 md:right-6"
  aria-label="Escribir por WhatsApp a Lailu3D"
>
  <IconoWhatsApp class="size-5" />
  <span class="hidden sm:inline">WhatsApp</span>
</a>
