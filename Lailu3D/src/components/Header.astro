---
import logo from '../assets/brand/logo-horizontal.svg';
import { idiomas, idiomaPorDefecto, type Idioma } from '../config/site';
import { waGeneral } from '../lib/whatsapp';
import { t, rutaLocalizada } from '../i18n';
import Boton from './ui/Boton.astro';
import IconoWhatsApp from './ui/IconoWhatsApp.astro';
import IconoNav, { type ClaveNav } from './ui/IconoNav.astro';

const idioma = (Astro.currentLocale ?? idiomaPorDefecto) as Idioma;
const txt = t(idioma);
const rutaActual = Astro.url.pathname;
const inicio = rutaLocalizada('/', idioma);
const enHome = rutaActual === inicio || rutaActual === `${inicio}/`;

/** Los anclas de la landing funcionan desde cualquier ruta. */
const ancla = (id: string) => (enHome ? `#${id}` : `${inicio}#${id}`);

/**
 * `actual` marca la seccion en la que se esta: las paginas propias (catalogo y
 * sus fichas, trabajos). Las anclas de la landing no se marcan, porque sin
 * JavaScript no se sabe hasta donde ha bajado el visitante.
 */
const esActual = (destino: string) =>
  rutaActual === destino || rutaActual.startsWith(`${destino}/`);

const enlaces: { clave: ClaveNav; texto: string; href: string; actual: boolean }[] = [
  { clave: 'servicios', texto: txt.nav.servicios, href: ancla('servicios'), actual: false },
  {
    clave: 'catalogo',
    texto: txt.nav.catalogo,
    href: rutaLocalizada('/productos', idioma),
    actual: esActual(rutaLocalizada('/productos', idioma)),
  },
  {
    clave: 'trabajos',
    texto: txt.nav.trabajos,
    href: rutaLocalizada('/trabajos', idioma),
    actual: esActual(rutaLocalizada('/trabajos', idioma)),
  },
  {
    clave: 'comoFunciona',
    texto: txt.nav.comoFunciona,
    href: ancla('como-funciona'),
    actual: false,
  },
];

/**
 * Selector de idioma. Conserva la ruta: desde una ficha de producto se llega a
 * esa misma ficha en el otro idioma, no al home.
 */
const opcionesIdioma = idiomas.map((codigo) => ({
  codigo,
  href: rutaLocalizada(rutaActual, codigo),
  actual: codigo === idioma,
  titulo: codigo === 'en' ? txt.nav.verEnIngles : txt.nav.verEnEspanol,
}));

const wa = waGeneral(idioma, rutaActual);
---

<header
  class="sticky top-0 z-40 border-b border-outline-variant bg-surface/90 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-margin-mobile md:px-margin"
  >
    <a
      href={inicio}
      class="shrink-0 rounded-[4px] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      aria-label={txt.nav.logoInicio}
    >
      <img src={logo.src} width={logo.width} height={logo.height} alt="Lailu3D" class="h-7 w-auto md:h-8" />
    </a>

    {/*
      Los iconos aparecen desde `lg`: entre 768 y 1024 px el menu, el selector
      de idioma y el boton de cotizar no caben con ellos.
    */}
    <nav aria-label={txt.nav.principal} class="hidden items-center gap-6 md:flex lg:gap-7">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            aria-current={enlace.actual ? 'page' : undefined}
            class:list={[
              'group relative inline-flex items-center gap-1.5 py-1 text-body-md transition-colors hover:text-on-surface',
              'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-copper after:transition-transform after:duration-300 hover:after:scale-x-100',
              enlace.actual
                ? 'text-on-surface after:scale-x-100'
                : 'text-on-surface-variant after:scale-x-0',
            ]}
          >
            <IconoNav
              clave={enlace.clave}
              class:list={[
                'hidden size-4 transition-[color,translate] duration-300 group-hover:-translate-y-px group-hover:text-copper lg:block motion-reduce:group-hover:translate-y-0',
                enlace.actual ? 'text-copper' : 'text-outline',
              ]}
            />
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {/* Dos idiomas: dos enlaces sueltos leen mejor que un desplegable. */}
      <nav
        aria-label={txt.nav.idioma}
        class="hidden items-center rounded-[4px] border border-outline-variant sm:flex"
      >
        {
          opcionesIdioma.map((opcion) => (
            <a
              href={opcion.href}
              hreflang={opcion.codigo}
              title={opcion.titulo}
              aria-current={opcion.actual ? 'true' : undefined}
              class:list={[
                'px-2.5 py-1.5 font-display text-label-sm uppercase transition-colors',
                opcion.actual
                  ? 'bg-primary text-on-primary'
                  : 'text-on-surface-variant hover:text-on-surface',
              ]}
            >
              {opcion.codigo}
            </a>
          ))
        }
      </nav>

      {/*
        Visible tambien en movil: es el CTA del negocio y cabe al lado del
        menu. Ojo, `hidden` no lo ocultaria: `Boton` trae `inline-flex` en su
        base y Tailwind emite esa utilidad despues de `.hidden`.
      */}
      <Boton href={rutaLocalizada('/cotizar', idioma)}>
        <IconoNav clave="cotizar" class="hidden size-4 sm:block" />
        {txt.nav.cotizar}
      </Boton>

      <details class="relative md:hidden" name="menu-movil">
        <summary
          class="flex size-10 cursor-pointer items-center justify-center rounded-[4px] border border-outline-variant bg-surface-lowest text-on-surface marker:content-none [&::-webkit-details-marker]:hidden"
          aria-label={txt.nav.abrirMenu}
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="square"></path>
          </svg>
        </summary>

        <nav
          aria-label={txt.nav.principalMovil}
          class="elev-3 absolute right-0 z-50 mt-2 flex w-60 flex-col rounded-lg p-2"
        >
          {
            enlaces.map((enlace) => (
              <a
                href={enlace.href}
                aria-current={enlace.actual ? 'page' : undefined}
                class:list={[
                  'group flex items-center gap-3 rounded-[4px] px-2 py-1.5 text-body-md transition-colors hover:bg-surface-low hover:text-on-surface',
                  enlace.actual ? 'bg-surface-low text-on-surface' : 'text-on-surface-variant',
                ]}
              >
                <span class="flex size-8 shrink-0 items-center justify-center rounded-[4px] border border-copper/25 bg-copper/10 text-primary">
                  <IconoNav clave={enlace.clave} />
                </span>
                {enlace.texto}
              </a>
            ))
          }
          {/* "Cotizar" ya esta en el boton de al lado; aqui va la via directa. */}
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 flex items-center gap-3 border-t border-outline-variant px-2 pt-2.5 pb-1.5 text-body-md text-primary"
          >
            <span class="flex size-8 shrink-0 items-center justify-center rounded-[4px] bg-primary text-on-primary">
              <IconoWhatsApp class="size-4" />
            </span>
            {txt.nav.escribirWhatsApp}
          </a>

          {/* El selector de escritorio va oculto por debajo de sm. */}
          <div
            class="mt-1 flex items-center gap-1 border-t border-outline-variant px-3 pt-2 sm:hidden"
          >
            {
              opcionesIdioma.map((opcion) => (
                <a
                  href={opcion.href}
                  hreflang={opcion.codigo}
                  title={opcion.titulo}
                  aria-current={opcion.actual ? 'true' : undefined}
                  class:list={[
                    'rounded-[4px] px-2 py-1 font-display text-label-sm uppercase',
                    opcion.actual
                      ? 'bg-primary text-on-primary'
                      : 'text-on-surface-variant',
                  ]}
                >
                  {opcion.codigo}
                </a>
              ))
            }
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
