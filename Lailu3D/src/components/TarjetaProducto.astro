---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { idiomaPorDefecto, type Idioma } from '../config/site';
import { formatearPrecio, categorias } from '../lib/formato';
import { t, rutaLocalizada } from '../i18n';
import Badge from './ui/Badge.astro';

/**
 * Tarjeta de producto. Se usa igual en la landing y en el catalogo: la ficha
 * completa vive en /productos/<id>.
 */
interface Props {
  producto: CollectionEntry<'productos'>;
  idioma?: Idioma;
  /**
   * Nivel del nombre. `3` por defecto, que es lo que corresponde cuando la
   * tarjeta cuelga de una seccion con `<h2>` (la landing). En el catalogo la
   * grilla cuelga directamente del `<h1>`, asi que alli va `2`: saltarse un
   * nivel rompe la navegacion por encabezados de un lector de pantalla.
   */
  nivelTitulo?: 2 | 3;
}

const { producto, idioma = idiomaPorDefecto, nivelTitulo = 3 } = Astro.props;
const { data } = producto;

/** La ficha del idioma que se esta viendo: desde /en no se vuelve al espanol. */
const ruta = rutaLocalizada(`/productos/${producto.id}`, idioma);
const alt = data.imagenAlt?.[idioma] ?? data.nombre[idioma];
const Nombre = `h${nivelTitulo}` as 'h2' | 'h3';

/**
 * Los filamentos llevan un SVG de bobina: va contenido, con aire y la regla al
 * pie. Las piezas impresas llevan foto (ya cuadrada desde el origen): va a
 * sangre, como en la galeria de trabajos.
 */
const esFoto = data.imagen.format !== 'svg';

/**
 * Con precio (filamentos) la tarjeta lleva estado y precio grande. Sin precio
 * (piezas bajo pedido, todas iguales) el estado no distingue nada: arriba va la
 * categoria y abajo "Bajo cotizacion" discreto con la invitacion a la ficha.
 */
const conPrecio = data.precio !== null;
const txt = t(idioma);
---

<a
  href={ruta}
  class="elev-2 group flex flex-col overflow-hidden rounded-lg transition-[border-color,box-shadow,translate] duration-300 hover:-translate-y-0.5 hover:border-copper/60 hover:shadow-[0_16px_40px_-12px_color-mix(in_srgb,var(--color-primary)_20%,transparent)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:hover:translate-y-0"
>
  {/* Bandeja hundida con regla de medicion al pie: la pieza "sobre la cama". */}
  <div class="relative aspect-square overflow-hidden bg-surface-low">
    {
      esFoto ? (
        <Image
          src={data.imagen}
          alt={alt}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 18rem, 45vw"
          class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        />
      ) : (
        <>
          <Image
            src={data.imagen}
            alt={alt}
            width={400}
            height={400}
            class="size-full object-contain p-6 transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
          <div class="regla absolute inset-x-4 bottom-3 h-1.5 text-outline-variant" aria-hidden="true" />
        </>
      )
    }
  </div>

  {/*
    En movil la grilla va a dos columnas: el cuerpo se compacta y el resumen
    se oculta (el nombre y la foto bastan para decidir si abrir la ficha).
  */}
  <div class="flex flex-1 flex-col border-t border-outline-variant p-3 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      {
        conPrecio ? (
          <Badge estado={data.disponibilidad} idioma={idioma} />
        ) : (
          <p class="truncate font-display text-label-sm uppercase text-primary">
            {categorias[data.categoria][idioma]}
          </p>
        )
      }
      {
        data.color && (
          <span
            class="size-3 shrink-0 rounded-[2px] border border-outline-variant"
            style={`background-color: ${data.color.hex}`}
            title={data.color.nombre[idioma]}
            aria-hidden="true"
          />
        )
      }
    </div>

    <Nombre class="mt-1.5 text-[15px] leading-5 font-medium text-on-surface sm:mt-2 sm:text-headline-sm">
      {data.nombre[idioma]}
    </Nombre>

    <p class="mt-2 hidden flex-1 text-body-sm text-on-surface-variant sm:block">
      {data.resumen[idioma]}
    </p>

    {
      conPrecio ? (
        <p class="mt-auto pt-3 font-display text-[17px] leading-6 font-medium text-primary tabular sm:pt-4 sm:text-headline-sm">
          {formatearPrecio(data.precio, idioma)}
        </p>
      ) : (
        <p class="mt-auto flex items-center justify-between gap-2 pt-3 sm:pt-4">
          <span class="font-display text-label-sm uppercase text-on-surface-variant">
            {formatearPrecio(data.precio, idioma)}
          </span>
          <span class="inline-flex items-center gap-1 font-display text-[14px] leading-5 font-medium text-primary">
            <span class="hidden sm:inline">{txt.catalogo.verFicha}</span>
            <svg
              class="size-4 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="square" />
            </svg>
          </span>
        </p>
      )
    }
  </div>
</a>
