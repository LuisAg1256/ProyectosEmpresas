---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { idiomaPorDefecto, type Idioma } from '../config/site';
import { formatearPrecio } from '../lib/formato';
import Badge from './ui/Badge.astro';

/**
 * Tarjeta de producto. Se usa igual en la landing y en el catalogo: la ficha
 * completa vive en /productos/<id>.
 */
interface Props {
  producto: CollectionEntry<'productos'>;
  idioma?: Idioma;
}

const { producto, idioma = idiomaPorDefecto } = Astro.props;
const { data } = producto;

const ruta = `/productos/${producto.id}`;
const alt = data.imagenAlt?.[idioma] ?? data.nombre[idioma];
---

<a
  href={ruta}
  class="elev-2 group flex flex-col overflow-hidden rounded-lg transition-colors hover:border-primary focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
>
  <div class="aspect-square bg-surface-container">
    <Image
      src={data.imagen}
      alt={alt}
      width={400}
      height={400}
      class="size-full object-contain p-4"
    />
  </div>

  <div class="flex flex-1 flex-col border-t border-outline-variant p-5">
    <Badge estado={data.disponibilidad} idioma={idioma} />

    <h3 class="mt-2 text-headline-sm text-on-surface">{data.nombre[idioma]}</h3>

    <p class="mt-2 flex-1 text-body-sm text-on-surface-variant">
      {data.resumen[idioma]}
    </p>

    <p class="mt-4 font-display text-headline-sm text-primary tabular">
      {formatearPrecio(data.precio, idioma)}
    </p>
  </div>
</a>
