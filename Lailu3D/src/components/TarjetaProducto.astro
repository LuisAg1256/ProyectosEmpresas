---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { idiomaPorDefecto, type Idioma } from '../config/site';
import { formatearPrecio } from '../lib/formato';
import { rutaLocalizada } from '../i18n';
import Badge from './ui/Badge.astro';

/**
 * Tarjeta de producto. Se usa igual en la landing y en el catalogo: la ficha
 * completa vive en /productos/<id>.
 */
interface Props {
  producto: CollectionEntry<'productos'>;
  idioma?: Idioma;
  /**
   * Nivel del nombre. `3` por defecto, que es lo que corresponde cuando la
   * tarjeta cuelga de una seccion con `<h2>` (la landing). En el catalogo la
   * grilla cuelga directamente del `<h1>`, asi que alli va `2`: saltarse un
   * nivel rompe la navegacion por encabezados de un lector de pantalla.
   */
  nivelTitulo?: 2 | 3;
}

const { producto, idioma = idiomaPorDefecto, nivelTitulo = 3 } = Astro.props;
const { data } = producto;

/** La ficha del idioma que se esta viendo: desde /en no se vuelve al espanol. */
const ruta = rutaLocalizada(`/productos/${producto.id}`, idioma);
const alt = data.imagenAlt?.[idioma] ?? data.nombre[idioma];
const Nombre = `h${nivelTitulo}` as 'h2' | 'h3';
---

<a
  href={ruta}
  class="elev-2 group flex flex-col overflow-hidden rounded-lg transition-[border-color,box-shadow,translate] duration-300 hover:-translate-y-0.5 hover:border-copper/60 hover:shadow-[0_16px_40px_-12px_color-mix(in_srgb,var(--color-primary)_20%,transparent)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:hover:translate-y-0"
>
  {/* Bandeja hundida con regla de medicion al pie: la pieza "sobre la cama". */}
  <div class="relative aspect-square overflow-hidden bg-surface-low">
    <Image
      src={data.imagen}
      alt={alt}
      width={400}
      height={400}
      class="size-full object-contain p-6 transition-transform duration-500 ease-out group-hover:scale-[1.04]"
    />
    <div class="regla absolute inset-x-4 bottom-3 h-1.5 text-outline-variant" aria-hidden="true"></div>
  </div>

  <div class="flex flex-1 flex-col border-t border-outline-variant p-5">
    <div class="flex items-center justify-between gap-3">
      <Badge estado={data.disponibilidad} idioma={idioma} />
      {
        data.color && (
          <span
            class="size-3 shrink-0 rounded-[2px] border border-outline-variant"
            style={`background-color: ${data.color.hex}`}
            title={data.color.nombre[idioma]}
            aria-hidden="true"
          />
        )
      }
    </div>

    <Nombre class="mt-2 text-headline-sm text-on-surface">
      {data.nombre[idioma]}
    </Nombre>

    <p class="mt-2 flex-1 text-body-sm text-on-surface-variant">
      {data.resumen[idioma]}
    </p>

    <p class="mt-4 font-display text-headline-sm text-primary tabular">
      {formatearPrecio(data.precio, idioma)}
    </p>
  </div>
</a>
