---
import logo from '../assets/brand/logo-horizontal.svg';
import { site, idiomaPorDefecto, type Idioma } from '../config/site';
import { waGeneral } from '../lib/whatsapp';
import { t, rutaLocalizada } from '../i18n';
import IconoWhatsApp from './ui/IconoWhatsApp.astro';
import IconoRed from './ui/IconoRed.astro';

const idioma = (Astro.currentLocale ?? idiomaPorDefecto) as Idioma;
const txt = t(idioma);
const wa = waGeneral(idioma, Astro.url.pathname);
const anio = new Date().getFullYear();

const inicio = rutaLocalizada('/', idioma);

/**
 * Se recorren las claves de `site.redes` en vez de escribir una lista aparte:
 * anadir una red en la configuracion la pone en el pie con su glifo, sin tocar
 * este archivo.
 */
type Red = keyof typeof site.redes;
const redes = (Object.keys(site.redes) as Red[]).map((red) => ({
  red,
  ...site.redes[red],
}));

const enlaces = [
  { texto: txt.nav.servicios, href: `${inicio}#servicios` },
  { texto: txt.nav.catalogo, href: rutaLocalizada('/productos', idioma) },
  { texto: txt.nav.trabajos, href: `${inicio}#trabajos` },
  { texto: txt.nav.comoFunciona, href: `${inicio}#como-funciona` },
  { texto: txt.nav.cotizar, href: rutaLocalizada('/cotizar', idioma) },
];
---

<footer class="border-t border-outline-variant bg-surface-low">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-margin-mobile py-12 md:grid-cols-3 md:px-margin"
  >
    <div>
      <img src={logo.src} width={logo.width} height={logo.height} alt="Lailu3D" loading="lazy" decoding="async" class="h-8 w-auto" />
      <p class="mt-4 max-w-xs text-body-md text-on-surface-variant">
        {txt.footer.descripcion}
      </p>
      <p class="mt-4 font-display text-label-sm uppercase text-on-surface-variant">
        {site.sucursales.join(' · ')} — {txt.footer.region}
      </p>
    </div>

    <div>
      <p class="font-display text-label-md uppercase text-on-surface-variant">
        {txt.footer.sitio}
      </p>
      <ul class="mt-4 flex flex-col gap-2">
        {
          enlaces.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class="text-body-md text-on-surface-variant hover:text-on-surface"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-display text-label-md uppercase text-on-surface-variant">
        {txt.footer.contacto}
      </p>
      <a
        href={wa}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-body-lg text-on-surface hover:text-primary"
      >
        <IconoWhatsApp class="size-5" />
        <span class="tabular">{site.whatsapp.display}</span>
      </a>
      <ul class="mt-4 flex flex-col gap-3">
        {
          redes.map((red) => (
            <li>
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-body-md text-on-surface-variant hover:text-on-surface"
              >
                <IconoRed red={red.red} class="size-5 shrink-0" />
                <span>
                  {red.nombre} {red.nick}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-outline-variant">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-margin-mobile py-6 text-body-sm text-on-surface-variant md:flex-row md:items-center md:justify-between md:px-margin"
    >
      <p>© {anio} {site.nombre}. {txt.footer.derechos}</p>
      <p>{txt.footer.aviso}</p>
    </div>
  </div>
</footer>
