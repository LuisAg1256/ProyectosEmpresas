---
/**
 * Boton del sistema "Precision Industrial Studio".
 *
 * Radio de 4px (chaflan mecanico): nunca pill. Con `href` renderiza un <a>,
 * que es la forma de todos los CTA de WhatsApp.
 */
interface Props {
  /**
   * `inverso` e `inverso-outline` son para los bloques de fondo cobre: alli el
   * primario se perderia. Van como variante y no como `class` porque dos
   * utilidades del mismo color compiten por orden de hoja de estilos, no por
   * orden de escritura en el atributo.
   */
  variante?:
    | 'primary'
    | 'secondary'
    | 'ghost'
    | 'inverso'
    | 'inverso-outline'
    | 'tinta';
  tamano?: 'md' | 'lg';
  href?: string;
  tipo?: 'button' | 'submit';
  /** Abre en pestaña nueva con rel seguro. Para los enlaces wa.me. */
  externo?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variante = 'primary',
  tamano = 'md',
  href,
  tipo = 'button',
  externo = false,
  class: clase = '',
  ...resto
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-[4px] font-display font-medium leading-none whitespace-nowrap transition-colors duration-150 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-offset-1 disabled:opacity-40 disabled:pointer-events-none';

/**
 * El color del anillo de foco va en cada variante y no en la base: dos
 * `ring-*` compiten por orden de hoja (alfabetico), y `ring-primary` le ganaba
 * a `ring-copper` en la variante `tinta`.
 */
const anilloClaro = 'focus-visible:ring-primary focus-visible:ring-offset-background';

const variantes = {
  primary: `bg-primary text-on-primary hover:bg-primary-container active:bg-on-primary-fixed-variant ${anilloClaro}`,
  secondary: `bg-surface-lowest text-on-surface border border-outline-variant hover:border-primary hover:bg-surface-low ${anilloClaro}`,
  ghost: `bg-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface-container ${anilloClaro}`,
  inverso: `bg-surface-lowest text-primary hover:bg-surface-low active:bg-surface-container ${anilloClaro}`,
  'inverso-outline': `bg-transparent text-on-primary border border-primary-fixed hover:bg-primary-container ${anilloClaro}`,
  /** Sobre el negro del footer. El cobre ahi da 6,39:1, asi que puede ser texto. */
  tinta:
    'bg-transparent text-ink-strong border border-copper/60 hover:bg-copper hover:border-copper hover:text-ink focus-visible:ring-copper focus-visible:ring-offset-ink',
} as const;

/** 15px y 17px: el tamaño va en valor explícito para no pelear con el peso del token tipográfico. */
const tamanos = {
  md: 'h-10 px-5 text-[15px]',
  lg: 'h-12 px-6 text-[17px]',
} as const;

const clases = [base, variantes[variante], tamanos[tamano], clase]
  .filter(Boolean)
  .join(' ');

const externoAttrs = externo
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

{
  href ? (
    <a href={href} class={clases} {...externoAttrs} {...resto}>
      <slot />
    </a>
  ) : (
    <button type={tipo} class={clases} {...resto}>
      <slot />
    </button>
  )
}
